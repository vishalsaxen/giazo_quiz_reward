rules_version = '2';
// Paste into Firebase console › Firestore Database › Rules, then Publish.
// Players (no login) can enter once and save one final score. Names, emails and phones are readable only by the admin, and by each signed-in seller for their own shop.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['vishalsaxen@gmail.com', 'gizee@giazonest.com'];
    }
    // Seller who claimed this quiz code's shop prefix (first 3 letters of shop + last 4 phone digits, e.g. DES_3210).
    function ownsSeller(code) {
      let parts = code.split('_');
      return request.auth != null && parts.size() == 3
        && get(/databases/$(database)/documents/sellers/$(parts[0] + '_' + parts[1])).data.owner == request.auth.uid;
    }
    function common(d) {
      return d.code is string && d.code.size() <= 40 && d.date is string && d.date.size() == 10
        && d.status == 'playing' && d.shop is string && d.prod is string && d.prize is string;
    }
    function finishing() {
      let d = request.resource.data;
      return resource.data.status == 'playing'
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'score', 'secs'])
        && d.status == 'done' && d.score is int && d.score >= 0 && d.score <= 100
        && d.secs is int && d.secs >= 0 && d.secs <= 300;
    }

    match /entries/{id} {
      allow read: if isAdmin() || ownsSeller(resource.data.code);
      allow create: if common(request.resource.data)
        && request.resource.data.keys().hasOnly(['code', 'date', 'status', 'shop', 'prod', 'prize', 'name', 'email', 'phone'])
        && request.resource.data.email is string && request.resource.data.phone is string && request.resource.data.name is string;
      allow update: if finishing();
    }
    // Public leaderboard rows: masked email and score only.
    match /results/{id} {
      allow read: if true;
      allow create: if common(request.resource.data)
        && request.resource.data.keys().hasOnly(['code', 'date', 'status', 'shop', 'prod', 'prize', 'masked'])
        && request.resource.data.masked is string;
      allow update: if finishing();
    }
    // Each seller's quiz and player link. Sellers (no login) save it. Anyone with a quiz code can open that one quiz
    // (the short player link loads its prize details from here); only the admin can list them.
    // One quiz per seller per day: a quiz can only be created after its seller's day lock (days/{phone digits}_{date}) names it.
    match /quizzes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['code', 'date', 'shop', 'phone', 'prod', 'desc', 'prize', 'url', 'data', 'pkey'])
        && request.resource.data.pkey is string
        && get(/databases/$(database)/documents/days/$(request.resource.data.pkey)).data.code == code
        && (!('data' in request.resource.data) || (request.resource.data.data is string && request.resource.data.data.size() < 3000))
        && request.resource.data.code == code && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.url is string && request.resource.data.url.size() < 4000
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 600;
    }
    // A seller's quiz for the day, keyed by phone digits and date. Created once; only the admin can clear it.
    match /days/{key} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if key.matches('[0-9]{6,16}_[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['code', 'date'])
        && request.resource.data.code is string && request.resource.data.code.size() <= 40
        && key.split('_')[1] == request.resource.data.date;
    }
    // Seller accounts: a signed-in seller claims their shop prefix once. Only the admin can change or remove a claim.
    match /sellers/{prefix} {
      allow read: if request.auth != null && (isAdmin() || resource.data.owner == request.auth.uid);
      allow create: if request.auth != null && prefix.matches('[A-Z]{3}_[0-9]{4}')
        && request.resource.data.keys().hasOnly(['owner', 'email', 'at'])
        && request.resource.data.owner == request.auth.uid && request.resource.data.email == request.auth.token.email;
      allow update, delete: if isAdmin();
    }
    // One per phone number per quiz per day. Never readable.
    match /locks/{id} {
      allow create: if request.resource.data.keys().hasOnly(['at']);
    }
  }
}
