rules_version = '2';
// Paste into Firebase console › Firestore Database › Rules, then Publish.
// Players (no login) can enter once and save one final score. Only the admin emails below can read names, emails and phones.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['vishalsaxen@gmail.com'];
    }
    function common(d) {
      return d.code is string && d.code.size() <= 40 && d.date is string && d.date.size() == 10
        && d.status == 'playing' && d.shop is string && d.prod is string && d.prize is string;
    }
    function finishing() {
      let d = request.resource.data;
      return resource.data.status == 'playing'
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'score', 'secs'])
        && d.status == 'done' && d.score is int && d.score >= 0 && d.score <= 100
        && d.secs is int && d.secs >= 0 && d.secs <= 300;
    }

    match /entries/{id} {
      allow read: if isAdmin();
      allow create: if common(request.resource.data)
        && request.resource.data.keys().hasOnly(['code', 'date', 'status', 'shop', 'prod', 'prize', 'name', 'email', 'phone'])
        && request.resource.data.email is string && request.resource.data.phone is string && request.resource.data.name is string;
      allow update: if finishing();
    }
    // Public leaderboard rows: masked email and score only.
    match /results/{id} {
      allow read: if true;
      allow create: if common(request.resource.data)
        && request.resource.data.keys().hasOnly(['code', 'date', 'status', 'shop', 'prod', 'prize', 'masked'])
        && request.resource.data.masked is string;
      allow update: if finishing();
    }
    // Each seller's quiz and player link. Sellers (no login) save it; only the admin can list them.
    match /quizzes/{code} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['code', 'date', 'shop', 'phone', 'prod', 'desc', 'prize', 'url'])
        && request.resource.data.code == code && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.url is string && request.resource.data.url.size() < 4000
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 600;
    }
    // One per phone number per quiz per day. Never readable.
    match /locks/{id} {
      allow create: if request.resource.data.keys().hasOnly(['at']);
    }
  }
}
